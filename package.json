{
  "name": "@local/dont-guess-ask",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "我是大肥鱼：以前你丢一句话我就替你把没说的地方补齐，补着补着就跑偏；现在先问「我猜你是要 A 还是 B」，你挑一个我再动手。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
